# Salin ke .env.local (tidak ikut dibagikan). Variabel VITE_* terbaca browser; sisanya hanya server (faucet).

# Chain: 31337 = anvil lokal, 10143 = Monad testnet
VITE_CHAIN_ID=31337
# RPC untuk browser. Testnet: pakai RPC berkunci (SPK-05: RPC publik kena 429 saat 50 request bersamaan)
VITE_RPC_URL=http://127.0.0.1:8545
# WebSocket untuk /layar dan /toko (satu koneksi). Kosongkan = polling HTTP.
VITE_WS_URL=ws://127.0.0.1:8545
# Opsional: override alamat contract + token tIDRX (default: shared/src/fotokopiKilat.generated.ts untuk chain di atas)
VITE_CONTRACT_ADDRESS=
VITE_TIDRX_ADDRESS=
# Backend PrintPitt (top-up Rupiah + relayer pesan tanpa gas). Default: anvil → http://127.0.0.1:8787,
# testnet → https://backend-production-2b31.up.railway.app (origin FE harus ada di ALLOWED_ORIGIN backend)
VITE_BACKEND_URL=
# Privy (login Google/email → embedded wallet) di /masuk. Kosong = hanya passkey Mera + tamu. App ID dari dashboard.privy.io
VITE_PRIVY_APP_ID=
# URL publik untuk QR di /layar, mis. https://<project>.vercel.app (default: origin halaman)
VITE_PUBLIC_URL=
# Interval polling status order di /pesan (ms). Jangan terlalu kecil: 50 HP berbagi rate limit RPC.
VITE_POLL_MS=1500

# --- Faucet MON lama (server saja, JANGAN pakai prefix VITE_). /pesan v2 tidak butuh MON: gas dibayar relayer backend. ---
# Private key wallet faucet: isi di env Vercel atau .env.local, jangan ditulis di vault/Drive.
# Anvil (31337): boleh kosong, otomatis memakai akun #5 dari mnemonic publik anvil.
FAUCET_PRIVATE_KEY=
# Default: VITE_RPC_URL
FAUCET_RPC_URL=
# Saldo awal per alamat baru. 1 order 0,02 MON + gas limit createOrder (250k x ~102 gwei = 0,0255) ~ 0,046 MON
FAUCET_AMOUNT_MON=0.1
